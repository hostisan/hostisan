# Hostisan's product domain and the addresses built on it. This is the one place
# the domain is written: the installers, bin/ and func/ (through product.sh),
# the deb control files, the panel binary and its UI, the release workflow and
# the tools all read it. To change the domain, edit HOSTISAN_DOMAIN and rebuild
# (RELEASING.md).
#
# Bash sources this file and Make includes it, so keep to plain KEY=value lines:
# no spaces, no quotes, and only ${HOSTISAN_...} references to earlier keys.
# tools/check-domain.sh fails when the domain appears anywhere else (docs aside).
HOSTISAN_DOMAIN=swurlex.site
HOSTISAN_URL=https://${HOSTISAN_DOMAIN}
HOSTISAN_DOCS_URL=${HOSTISAN_URL}/docs
HOSTISAN_INFO_EMAIL=info@${HOSTISAN_DOMAIN}
HOSTISAN_SECURITY_EMAIL=security@${HOSTISAN_DOMAIN}
