# Hostisan panel settings, read by hostisan.service (EnvironmentFile).
# Installed to /usr/local/hestia/conf/hostisan.env once; upgrades keep it.

# Per-file restore from incremental (restic) backups: "on" or "off".
# On since the restic symlink checks (VPS check V6, core edit PF4b) passed.
# Set it to "off" and run "systemctl restart hostisan" to turn it off.
HOSTISAN_FILE_RESTORE=on
